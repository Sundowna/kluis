# Maintainer: Sundowna <https://github.com/Sundowna>
# Arch Linux / EndeavourOS / Manjaro package for Kluis.
# Build from this folder with:  makepkg -si
pkgname=kluis
pkgver=0.3.1
pkgrel=1
pkgdesc="Unofficial Proton Drive desktop client (folder and photo sync), built on the official Proton Drive CLI"
arch=('any')
url="https://github.com/Sundowna/kluis"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk3' 'gdk-pixbuf2' 'libsecret' 'libayatana-appindicator')
optdepends=('xapp: native panel icon on Cinnamon, MATE and Xfce'
            'gnome-keyring: keeps your Proton sign-in if KWallet is not set up'
            'ffmpegthumbnailer: video previews in the Photos tab'
            'gnome-desktop: share photo thumbnails with your file manager')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/usr/lib/kluis"
  cp -r kluis "$pkgdir/usr/lib/kluis/"
  find "$pkgdir" -name __pycache__ -prune -exec rm -rf {} +
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/kluis" <<'SH'
#!/bin/sh
export PYTHONPATH="/usr/lib/kluis${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m kluis "$@"
SH
  install -Dm644 kluis/data/icons/dev.kluis.Kluis.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.kluis.Kluis.svg"
  install -Dm644 packaging/dev.kluis.Kluis.desktop "$pkgdir/usr/share/applications/dev.kluis.Kluis.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/kluis/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/kluis/LICENSE"
}
