#!/usr/bin/env python3
"""Stand-in for the official `proton-drive` CLI, for tests only.

Mimics the real command names, flags, JSON shapes, exit codes and error texts
(taken from ProtonDriveApps/sdk cli/src). The "cloud" is a folder: $MOCK_ROOT/my-files.
"""
import hashlib
import json
import os
import shutil
import sys
import time

ROOT = os.environ.get("MOCK_ROOT", "/tmp/mock-proton")
os.makedirs(os.path.join(ROOT, "my-files"), exist_ok=True)
os.makedirs(os.path.join(ROOT, ".trash"), exist_ok=True)
LOGGED = os.path.join(ROOT, ".logged_in")
DELAY = float(os.environ.get("MOCK_DELAY", "0"))


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def local(path):
    path = "/" + path.strip("/")
    if path == "/":
        return ROOT
    return os.path.join(ROOT, path.lstrip("/"))


def sha1(p):
    h = hashlib.sha1()
    with open(p, "rb") as f:
        h.update(f.read())
    return h.hexdigest()


def node(p):
    st = os.stat(p)
    iso = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(st.st_mtime))
    n = {"uid": "uid-" + hashlib.md5(p.encode()).hexdigest()[:10], "name": {"ok": True, "value": os.path.basename(p)},
         "type": "folder" if os.path.isdir(p) else "file", "isShared": False, "isSharedByUrl": False,
         "creationTime": iso, "modificationTime": iso, "directRole": "admin", "treeEventScopeId": "x",
         "keyAuthor": {"ok": True, "value": "me@proton.me"}, "ownedBy": {"email": "me@proton.me"}}
    if os.path.isfile(p):
        s = sha1(p)
        n["mediaType"] = "application/octet-stream"
        n["activeRevision"] = {"uid": f"rev-{s[:12]}-{st.st_mtime_ns}", "state": "active", "claimedSize": st.st_size,
                               "claimedModificationTime": iso, "claimedDigests": {"sha1": s, "sha1Verified": True}}
    return n


def opts(argv, names):
    pos, o, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--json", "-j", "--verbose", "-v", "--skip-thumbnails", "-t", "--load-details", "-d"):
            o[a.lstrip("-")] = True
        elif a.startswith("--") and a[2:] in names:
            o[a[2:]] = argv[i + 1]
            i += 1
        else:
            pos.append(a)
        i += 1
    return pos, o


HELP = {
    "": """Usage:
    auth login
    auth logout
    filesystem list [-t TYPE] path
    filesystem info path
    filesystem size path
    filesystem create-folder parentPath name
    filesystem upload [-f STRATEGY] [-d STRATEGY] [-t] localPath... parentPath
    filesystem download [-f STRATEGY] [-d STRATEGY] path... localFolder
    filesystem rename path newName
    filesystem trash path...
    filesystem restore path...
    filesystem delete path...
    album list
    album photos [-d] albumPath
    photo timeline [-d]
    photo upload [-c STRATEGY] localPath...
    photo download [-c STRATEGY] path... localFolder
""",
    "filesystem upload": "-f, --file-conflict-strategy create-new-revision rename replace skip "
                         "-d, --folder-conflict-strategy merge rename replace skip -t, --skip-thumbnails",
    "filesystem download": "-f, --file-conflict-strategy rename remove skip -d, --folder-conflict-strategy merge rename remove skip",
    "photo upload": "-c, --conflict-strategy skip rename",
    "photo download": "-c, --conflict-strategy rename remove skip",
}


def mock_flag(name):
    return os.path.exists(os.path.join(ROOT, "." + name))


def main():
    argv = sys.argv[1:]
    if not argv:
        fail("interactive shell not supported in mock", 2)
    group, cmd, rest = argv[0], (argv[1] if len(argv) > 1 else ""), argv[2:]
    if group == "fs":
        group = "filesystem"
    if "--help" in argv or "-h" in argv:
        key = " ".join(a for a in argv[:2] if not a.startswith("-")) if group not in ("--help", "-h") else ""
        text = HELP.get(key, HELP[""] if not key else f"Usage:\n    {key}")
        if os.environ.get("MOCK_INCOMPATIBLE") or mock_flag("incompatible"):
            text = text.replace("filesystem restore path...\n", "").replace("create-new-revision", "new-rev")
        print(text)
        return
    if group == "version":
        v = os.environ.get("MOCK_VERSION") or "0.9.0"
        print(f"Proton Drive CLI cli-drive@{v}\nProton Drive SDK 0.14.0\nYou are running the latest version.")
        return
    if group == "auth" and cmd == "login":
        print(json.dumps({"signInUrl": "https://account.proton.me/mock-sign-in"}), flush=True)
        if mock_flag("login-hang"):
            time.sleep(3600)
        time.sleep(float(os.environ.get("MOCK_LOGIN_DELAY", "1.5")))
        open(LOGGED, "w").close()
        return
    if mock_flag("offline"):
        fail("TypeError: fetch failed (getaddrinfo ENOTFOUND drive-api.proton.me)")
    if group == "auth" and cmd == "logout":
        if os.path.exists(LOGGED):
            os.remove(LOGGED)
        return
    if not os.path.exists(LOGGED):
        fail("You need to login first")
    time.sleep(DELAY)
    pos, o = opts(rest, {"file-conflict-strategy", "folder-conflict-strategy", "type", "conflict-strategy"})

    trash_dir = os.path.join(ROOT, ".trash")
    index_p = os.path.join(trash_dir, "index.json")
    index = json.load(open(index_p)) if os.path.exists(index_p) else {}
    shared_p = os.path.join(ROOT, "shared.json")
    shared = json.load(open(shared_p)) if os.path.exists(shared_p) else {}

    def shared_node(name):
        n = node(os.path.join(ROOT, "shared-with-me", name))
        meta = shared.get(name, {})
        n["uid"] = "share-" + hashlib.md5(name.encode()).hexdigest()[:8]
        n["directRole"] = meta.get("role", "viewer")
        n["membership"] = {"role": meta.get("role", "viewer"), "inviteTime": meta.get("on", "2026-01-01T00:00:00.000Z"),
                           "sharedBy": {"ok": True, "value": meta.get("by", "someone@proton.me")}}
        return n

    def resolve(path):
        """Map /shared-with-me/<uid or name>/… to the mock folder."""
        parts = path.strip("/").split("/")
        if parts[0] == "shared-with-me" and len(parts) > 1:
            for name in os.listdir(os.path.join(ROOT, "shared-with-me")) if os.path.isdir(
                    os.path.join(ROOT, "shared-with-me")) else []:
                if parts[1] in (name, "share-" + hashlib.md5(name.encode()).hexdigest()[:8]):
                    parts[1] = name
            return os.path.join(ROOT, *parts)
        return local(path)

    if group == "filesystem" and cmd == "list":
        path = pos[0]
        if path.strip("/") == "":
            print(json.dumps([{"path": "/my-files"}, {"path": "/devices"}, {"path": "/shared-with-me"},
                              {"path": "/trash"}]))
            return
        if path.strip("/") == "trash":
            out = []
            for uid, e in index.items():
                if os.path.exists(e["stored"]):
                    n = node(e["stored"])
                    n["uid"], n["name"]["value"], n["trashTime"] = uid, os.path.basename(e["orig"]), e["time"]
                    out.append(n)
            print(json.dumps(out))
            return
        if path.strip("/") == "shared-with-me":
            d = os.path.join(ROOT, "shared-with-me")
            print(json.dumps([shared_node(n) for n in sorted(os.listdir(d))] if os.path.isdir(d) else []))
            return
        d = resolve(path)
        if not os.path.isdir(d):
            fail(f"Node not found: {os.path.basename(path)}")
        items = [node(os.path.join(d, n)) for n in sorted(os.listdir(d))]
        print("[\n" + ",\n".join(json.dumps(i) for i in items) + "\n]")
        return

    if group == "filesystem" and cmd == "size":
        d = resolve(pos[0])
        if not os.path.exists(d):
            fail(f"Node not found: {os.path.basename(pos[0])}")
        tot, cnt = 0, 0
        for dp, dns, fns in os.walk(d):
            cnt += len(dns) + len(fns)
            tot += sum(os.path.getsize(os.path.join(dp, f)) for f in fns)
        print(json.dumps({"size": tot, "numberOfDescendants": cnt}))
        return

    if group == "filesystem" and cmd == "info":
        d = resolve(pos[0])
        if not os.path.exists(d):
            fail(f"Node not found: {os.path.basename(pos[0])}")
        print(json.dumps(node(d)))
        return

    if group == "filesystem" and cmd == "restore":
        for p in pos:
            uid = p.strip("/").split("/")[-1]
            e = index.get(uid)
            if not e or not os.path.exists(e["stored"]):
                fail(f"Node not found: {uid}")
            if os.path.exists(e["orig"]):
                fail("A file or folder with that name already exists")
            os.makedirs(os.path.dirname(e["orig"]), exist_ok=True)
            shutil.move(e["stored"], e["orig"])
            del index[uid]
        json.dump(index, open(index_p, "w"))
        print(json.dumps([{"ok": True} for _ in pos]))
        return

    if group == "filesystem" and cmd == "delete":
        for p in pos:
            uid = p.strip("/").split("/")[-1]
            e = index.get(uid)
            if not e:
                fail(f"Node not found: {uid}")
            if os.path.isdir(e["stored"]):
                shutil.rmtree(e["stored"])
            elif os.path.exists(e["stored"]):
                os.unlink(e["stored"])
            del index[uid]
        json.dump(index, open(index_p, "w"))
        print(json.dumps([{"ok": True} for _ in pos]))
        return

    if group == "filesystem" and cmd == "create-folder":
        parent, name = pos
        d = resolve(parent)
        if not os.path.isdir(d):
            fail(f"Node not found: {os.path.basename(parent)}")
        t = os.path.join(d, name)
        if os.path.exists(t):
            fail("A file or folder with that name already exists")
        os.mkdir(t)
        print(json.dumps(node(t)))
        return

    if group == "filesystem" and cmd == "upload":
        *srcs, parent = pos
        d = resolve(parent)
        if not os.path.isdir(d):
            fail(f"Node not found: {os.path.basename(parent)}")
        fs = o.get("file-conflict-strategy", "")
        summary = {"transferredItems": 0, "transferredBytes": 0, "skippedItems": 0, "failedItems": 0, "failures": []}

        def up(src, dst_dir):
            t = os.path.join(dst_dir, os.path.basename(src))
            if os.path.isdir(src):
                os.makedirs(t, exist_ok=True)
                for n in os.listdir(src):
                    up(os.path.join(src, n), t)
                return
            if os.path.exists(t):
                if sha1(t) == sha1(src):
                    return  # identical content is skipped automatically
                if fs == "skip":
                    summary["skippedItems"] += 1
                    return
                if fs not in ("create-new-revision", "replace", "rename"):
                    summary["failedItems"] += 1
                    summary["failures"].append({"name": os.path.basename(src), "error": "Name conflict"})
                    return
            if "FAILME" in os.path.basename(src):
                summary["failedItems"] += 1
                summary["failures"].append({"name": os.path.basename(src), "error": "Simulated failure"})
                return
            time.sleep(float(os.environ.get("MOCK_UPLOAD_DELAY", "0")))
            shutil.copyfile(src, t + ".mock-upload")   # a cut connection never leaves a half file
            os.replace(t + ".mock-upload", t)
            summary["transferredItems"] += 1
            summary["transferredBytes"] += os.path.getsize(src)

        for s in srcs:
            up(s, d)
        print(json.dumps(summary))
        if summary["failedItems"]:
            fail(f"{summary['failedItems']} item(s) failed to upload")
        return

    if group == "filesystem" and cmd == "download":
        *srcs, dest = pos
        os.makedirs(dest, exist_ok=True)
        fs = o.get("file-conflict-strategy", "")
        summary = {"transferredItems": 0, "transferredBytes": 0, "skippedItems": 0, "failedItems": 0, "failures": []}

        def down(src, dst_dir):
            t = os.path.join(dst_dir, os.path.basename(src))
            if os.path.isdir(src):
                os.makedirs(t, exist_ok=True)
                for n in os.listdir(src):
                    down(os.path.join(src, n), t)
                return
            if os.path.exists(t):
                if fs == "skip":
                    return
                if fs == "remove":
                    os.unlink(t)
                else:
                    summary["failedItems"] += 1
                    summary["failures"].append({"name": os.path.basename(src), "error": "Name conflict"})
                    return
            shutil.copyfile(src, t)
            summary["transferredItems"] += 1
            summary["transferredBytes"] += os.path.getsize(src)

        if mock_flag("diskfull"):
            fail("Error: ENOSPC: no space left on device, write")
        for s in srcs:
            p = resolve(s)
            if not os.path.exists(p):
                fail(f"Node not found: {os.path.basename(s)}")
            down(p, dest)
        print(json.dumps(summary))
        return

    if group == "filesystem" and cmd == "trash":
        out = []
        for p in pos:
            lp = resolve(p)
            if not os.path.exists(lp):
                fail(f"Node not found: {os.path.basename(p)}")
            uid = node(lp)["uid"] + "-" + str(time.time_ns())[-6:]
            stored = os.path.join(trash_dir, f"{time.time_ns()}-{os.path.basename(lp)}")
            shutil.move(lp, stored)
            index[uid] = {"orig": lp, "stored": stored, "time": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())}
            out.append({"uid": uid, "ok": True})
        json.dump(index, open(index_p, "w"))
        print(json.dumps(out))
        return

    if group == "filesystem" and cmd == "rename":
        src, new = pos
        lp = resolve(src)
        if not os.path.exists(lp):
            fail(f"Node not found: {os.path.basename(src)}")
        t = os.path.join(os.path.dirname(lp), new)
        if os.path.exists(t):
            fail("A file or folder with that name already exists")
        os.rename(lp, t)
        print(json.dumps(node(t)))
        return

    # ---------- photos: $MOCK_ROOT/photostore/<uid>/<name>, meta.json, albums.json ----------
    store = os.path.join(ROOT, "photostore")
    os.makedirs(store, exist_ok=True)
    meta_p, albums_p = os.path.join(ROOT, "photometa.json"), os.path.join(ROOT, "albums.json")
    meta = json.load(open(meta_p)) if os.path.exists(meta_p) else {}
    albums = json.load(open(albums_p)) if os.path.exists(albums_p) else {}

    def pfile(uid):
        d = os.path.join(store, uid)
        return os.path.join(d, os.listdir(d)[0])

    def pnode(uid):
        n = node(pfile(uid))
        n["uid"], n["type"] = uid, "photo"
        n["mediaType"] = "video/mp4" if pfile(uid).endswith(".mp4") else "image/jpeg"
        n["photo"] = {"captureTime": meta[uid]["captured"], "mainPhotoNodeUid": None}
        return n

    if group == "photo" and cmd == "timeline":
        uids = sorted(meta, key=lambda u: meta[u]["captured"], reverse=True)
        print(json.dumps([pnode(u) for u in uids]))
        return
    if group == "album" and cmd == "list":
        print(json.dumps([{"uid": a, "name": {"ok": True, "value": v["name"]}, "type": "album",
                           "creationTime": "2026-01-01T00:00:00.000Z", "album": {"photoCount": len(v["photos"])}}
                          for a, v in albums.items()]))
        return
    if group == "album" and cmd == "photos":
        a = pos[0].split("/")[-1]
        if a not in albums:
            fail(f"Album not found: {a}")
        print(json.dumps([pnode(u) for u in albums[a]["photos"] if u in meta]))
        return
    if group == "photo" and cmd == "download":
        o2 = o
        *srcs, dest = pos
        os.makedirs(dest, exist_ok=True)
        summary = {"transferredItems": 0, "transferredBytes": 0, "skippedItems": 0, "failedItems": 0, "failures": []}
        for s in srcs:
            uid = s.split("/")[-1]
            if uid not in meta:
                fail(f"Photo not found: {uid}")
            src = pfile(uid)
            name = os.path.basename(src)
            t = os.path.join(dest, name)
            if os.path.exists(t):
                st = o2.get("conflict-strategy")
                if st == "skip":
                    continue
                if st == "rename":
                    stem, ext = os.path.splitext(name)
                    i = 1
                    while os.path.exists(t):
                        t = os.path.join(dest, f"{stem} ({i}){ext}")
                        i += 1
                elif st == "remove":
                    os.unlink(t)
            shutil.copyfile(src, t)
            summary["transferredItems"] += 1
        print(json.dumps(summary))
        return
    if group == "photo" and cmd == "upload":
        o2 = o
        summary = {"transferredItems": 0, "transferredBytes": 0, "skippedItems": 0, "failedItems": 0, "failures": []}
        files = []
        for s in pos:
            if os.path.isdir(s):
                for dp, _, fns in os.walk(s):
                    files += [os.path.join(dp, f) for f in fns]
            else:
                files.append(s)
        for f in files:
            dup = [u for u in meta if os.path.basename(pfile(u)) == os.path.basename(f) and sha1(pfile(u)) == sha1(f)]
            if dup:
                if o2.get("conflict-strategy") == "skip":
                    continue
            uid = hashlib.md5((f + str(time.time_ns())).encode()).hexdigest()[:22] + "~" + "a" * 22
            os.makedirs(os.path.join(store, uid))
            shutil.copyfile(f, os.path.join(store, uid, os.path.basename(f)))
            meta[uid] = {"captured": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(os.path.getmtime(f)))}
            summary["transferredItems"] += 1
        json.dump(meta, open(meta_p, "w"))
        print(json.dumps(summary))
        return

    fail(f"Command not found: {group} {cmd}")


main()
